# Codex Policy Intelligence Engine — Environment Configuration
# Copy this file to .env and fill in real values.

# ── Database ──────────────────────────────────────────────
# PostgreSQL (required — no SQLite fallback)
DATABASE_URL=postgresql://codex_admin:securepassword123@localhost:5432/codex_db

# ── Neo4j Knowledge Graph ─────────────────────────────────
NEO4J_URI=bolt://localhost:7687

# ── Authentication ────────────────────────────────────────
# Change this to a long random string in production!
SECRET_KEY=change-this-to-a-random-secure-string
ALGORITHM=HS256
TOKEN_EXPIRE_MINUTES=30

# ── LLM Servers (llama.cpp) ───────────────────────────────
# Qwen3-8B — grounded QA reasoning (thinking on)
QWEN3_8B_URL=http://localhost:8080/v1/chat/completions
QWEN3_8B_MODEL=Qwen3-8B-Q4_K_M.gguf

# Qwen3-4B — clause detection, intent classification, graph generation
QWEN3_4B_URL=http://localhost:8081/v1/chat/completions
QWEN3_4B_MODEL=Qwen3-4B-Instruct-2507-UD-Q4_K_XL.gguf

# ── Embedding Models ──────────────────────────────────────
RETRIEVER_MODEL=BAAI/bge-large-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base

# ── Search Tuning ─────────────────────────────────────────
TOP_K_RETRIEVAL=20
TOP_K_FINAL=3
RRF_K=60

# ── Ingestion ─────────────────────────────────────────────
MAX_CLAUSE_TOKENS=200
OVERLAP_TOKENS=20

# ── Slack Integration ──────────────────────────────────────
# Signed inbound webhook: POST /v1/integrations/slack
# Signing secret from the Slack app's "Basic Information" page.
# Leave SLACK_SIGNING_SECRET empty to run in dev mode (signature skipped).
SLACK_SIGNING_SECRET=
# Bot token (scopes: chat:write, app_mentions:read) — OAuth & Permissions.
SLACK_BOT_TOKEN=
# Codex API base URL the bot uses to submit queries.
CODEX_API_URL=http://localhost:8000
# Slack user -> Codex username mapping lives in integrations/slack_users.json.
