# ═══════════════════════════════════════════════════════════════
# Codex Policy Intelligence Engine — Environment Configuration
# Copy this file to .env and fill in real values.
# ═══════════════════════════════════════════════════════════════

# ── Infrastructure Paths ──────────────────────────────────────
CODEX_DIR=/home/mujtaba/new_folder/codex
VENV_DIR=/home/mujtaba/new_folder/fastmcp/venv
PG_BIN=/home/mujtaba/postgresql/bin
PG_DATA=/home/mujtaba/pgdata
NEO4J_HOME=/home/mujtaba/neo4j-community-5.26.0
MODELS_DIR=/home/mujtaba/models

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password123
POSTGRES_DB=codex_db
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── Neo4j ─────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_AUTH=neo4j/password123
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ── Qwen3-8B Reasoner (port 8080, GPU) ───────────────────────
QWEN3_8B_MODEL_PATH=${MODELS_DIR}/Qwen3-8B-Q4_K_M.gguf
QWEN3_8B_MODEL=Qwen3-8B-Q4_K_M.gguf
LLM_8B_PORT=8080
GPU_LAYERS_8B=30
CTX_SIZE_8B=16384
THREADS_8B=8
THREADS_BATCH_8B=16
PARALLEL_8B=1
LLAMA_8B_URL=http://localhost:${LLM_8B_PORT}

# ── Qwen3-4B Classifier/Graph (port 8081, GPU) ───────────────
QWEN3_4B_MODEL_PATH=${MODELS_DIR}/Qwen3-4B-Instruct-2507-UD-Q4_K_XL.gguf
QWEN3_4B_MODEL=Qwen3-4B-Instruct-2507-UD-Q4_K_XL.gguf
LLM_4B_PORT=8081
GPU_LAYERS_4B=10
CTX_SIZE_4B=16384
THREADS_4B=4
THREADS_BATCH_4B=8
PARALLEL_4B=1
LLAMA_4B_URL=http://localhost:${LLM_4B_PORT}

# ── API ───────────────────────────────────────────────────────
CODEX_API_URL=http://localhost:8000
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=
ALGORITHM=HS256
TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501"]

# ── UI ────────────────────────────────────────────────────────
UI_PORT=8501

# ── Python ────────────────────────────────────────────────────
PYTHONPATH=/home/mujtaba/new_folder

# ── Embedding Models ──────────────────────────────────────────
RETRIEVER_MODEL=BAAI/bge-large-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
RETRIEVER_DEVICE=cpu
RERANKER_DEVICE=cpu
EMBEDDING_DEVICE=cpu

# ── Search Tuning ─────────────────────────────────────────────
TOP_K_RETRIEVAL=20
TOP_K_FINAL=5
RRF_K=60
DEFAULT_SEARCH_MODE=hybrid
HISTORY_TURNS=5

# ── Ingestion ─────────────────────────────────────────────────
MAX_CLAUSE_TOKENS=200
OVERLAP_TOKENS=20
USE_LLM_FOR_CHUNKING=true
GRAPH_BATCH_SIZE=30
CLAIM_INTERVAL=3

# ── Slack Integration ─────────────────────────────────────────
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_DEFAULT_USERNAME=employee
SLACK_QUERY_TIMEOUT=120
