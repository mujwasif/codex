# ═══════════════════════════════════════════════════════════════
# Codex Policy Intelligence Engine — Environment Configuration
# Copy this file to .env and fill in real values.
# ═══════════════════════════════════════════════════════════════

# ── Infrastructure Paths ──────────────────────────────────────
CODEX_DIR=
VENV_DIR=
PG_BIN=
PG_DATA=.data/postgres
NEO4J_HOME=
LLAMA_CPP_DIR=
LLAMA_CPP_BIN=
MODELS_DIR=
ARCHIVE_DIR=
DATA_DIR=
LOG_DIR=
STATE_DIR=

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=codex_admin
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=codex_db
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:5432/${POSTGRES_DB}
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── Neo4j ─────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_AUTH=neo4j/change-this-password
NEO4J_USER=neo4j
NEO4J_PASS=change-this-password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ── LLM API ───────────────────────────────────────────────────
LLM_PROVIDER=auto
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_INGESTION_MODEL=gpt-4o-mini

# ── Local Qwen fallback (set LLM_PROVIDER=local) ──────────────
QWEN3_8B_MODEL_PATH=
QWEN3_8B_MODEL_URL=
QWEN3_8B_MODEL=Qwen3-8B-Q4_K_M.gguf
LLM_8B_PORT=8080
GPU_LAYERS_8B=30
CTX_SIZE_8B=16384
THREADS_8B=8
THREADS_BATCH_8B=16
PARALLEL_8B=1
LLAMA_8B_URL=http://localhost:${LLM_8B_PORT}

# ── Qwen3-4B Classifier/Graph (port 8081, GPU) ───────────────
QWEN3_4B_MODEL_PATH=
QWEN3_4B_MODEL_URL=
QWEN3_4B_MODEL=Qwen3-4B-Instruct-2507-UD-Q4_K_XL.gguf
LLM_4B_PORT=8081
GPU_LAYERS_4B=10
CTX_SIZE_4B=16384
THREADS_4B=4
THREADS_BATCH_4B=8
PARALLEL_4B=1
LLAMA_4B_URL=http://localhost:${LLM_4B_PORT}
CODEX_CUDA=false

# ── API ───────────────────────────────────────────────────────
CODEX_API_URL=http://localhost:8000
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=
ALGORITHM=HS256
TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501"]

# ── UI ────────────────────────────────────────────────────────
UI_PORT=8501

# ── Python ────────────────────────────────────────────────────
PYTHONPATH=

# ── Embedding Models ──────────────────────────────────────────
RETRIEVER_MODEL=BAAI/bge-large-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
RETRIEVER_DEVICE=cpu
RERANKER_DEVICE=cpu
EMBEDDING_DEVICE=cpu

# ── Search Tuning ─────────────────────────────────────────────
TOP_K_RETRIEVAL=20
TOP_K_FINAL=5
RRF_K=60
DEFAULT_SEARCH_MODE=hybrid
HISTORY_TURNS=5
HISTORY_MAX_TOKENS=2500

# ── Ingestion ─────────────────────────────────────────────────
MAX_CLAUSE_TOKENS=200
OVERLAP_TOKENS=20
USE_LLM_FOR_CHUNKING=true
GRAPH_BATCH_SIZE=30
CLAIM_INTERVAL=3

# ── Slack Integration ─────────────────────────────────────────
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_DEFAULT_USERNAME=employee
SLACK_QUERY_TIMEOUT=120
