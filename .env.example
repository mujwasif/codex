# ═══════════════════════════════════════════════════════════════
# Codex Policy Intelligence Engine — Environment Configuration
# Copy this file to .env and fill in real values.
# ═══════════════════════════════════════════════════════════════

# ── Infrastructure Paths ──────────────────────────────────────
CODEX_DIR=
VENV_DIR=
PG_BIN=
PG_DATA=.data/postgres
ARCHIVE_DIR=
DATA_DIR=
LOG_DIR=
STATE_DIR=

# Mock User Credentials (used when SEED_DEFAULT_USERS=true)
# admin    / password123
# manager  / password123
# employee / password123

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=codex_admin
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=codex_db
PG_ADMIN_USER=postgres
SEED_DEFAULT_USERS=true
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:5432/${POSTGRES_DB}
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── Neo4j ─────────────────────────────────────────────────────
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_AUTH=neo4j/change-this-password
NEO4J_USER=neo4j
NEO4J_PASS=change-this-password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ── Hosted LLM API ─────────────────────────────────────────────
LLM_PROVIDER=api
LLM_API_KEY=
LLM_BASE_URL=https://funkash.eu1.netbird.services/llm/v1
LLM_MODEL=hf.co/Qwen/Qwen3-8B-GGUF:Q4_K_M
LLM_INGESTION_MODEL=hf.co/unsloth/Qwen3-4B-Instruct-2507-GGUF:UD-Q4_K_XL


# ── API ───────────────────────────────────────────────────────
CODEX_API_URL=http://127.0.0.1:8000
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=
ALGORITHM=HS256
TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS='["http://localhost:8501","http://127.0.0.1:8501"]'

# ── UI ────────────────────────────────────────────────────────
UI_PORT=8501

# ── Python ────────────────────────────────────────────────────
PYTHONPATH=

# ── Embedding Models ──────────────────────────────────────────
RETRIEVER_MODEL=BAAI/bge-large-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
RETRIEVER_DEVICE=cpu
RERANKER_DEVICE=cpu
EMBEDDING_DEVICE=cpu

# ── Search Tuning ─────────────────────────────────────────────
TOP_K_RETRIEVAL=20
TOP_K_FINAL=5
RRF_K=60
DEFAULT_SEARCH_MODE=hybrid
HISTORY_TURNS=5
HISTORY_MAX_TOKENS=2500

# ── Ingestion ─────────────────────────────────────────────────
MAX_CLAUSE_TOKENS=200
OVERLAP_TOKENS=20
USE_LLM_FOR_CHUNKING=true
GRAPH_BATCH_SIZE=30
CLAIM_INTERVAL=3

# ── Slack Integration ─────────────────────────────────────────
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_DEFAULT_USERNAME=employee
SLACK_QUERY_TIMEOUT=120
